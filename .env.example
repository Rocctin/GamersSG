# Database
# PostgreSQL connection string.
# Default dev values are: postgres:password@localhost:5432/gamers_sg
# To use custom credentials without editing this file, export before running dev-setup.sh:
#   export PGUSER=postgres PGPASSWORD=mypass PGHOST=localhost PGPORT=5432 PGDATABASE=gamers_sg
DATABASE_URL=postgresql://postgres:password@localhost:5432/gamers_sg

# Backend
JWT_SECRET=replace-with-64-char-random-hex
RESEND_API_KEY=re_placeholder
FRONTEND_URL=http://localhost:3001
PORT=3000
NODE_ENV=development
