// Gamers.SG — Prisma Schema
// Phase 1: Auth + RBAC + Foundation
// DBMS: PostgreSQL
// Resend magic-link auth (SingPass swap-in ready)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  GAMER
  ORGANISER
  ADMIN
}

enum AccountStatus {
  PENDING    // Organiser submitted, awaiting SCOGA approval
  APPROVED   // Active and fully accessible
  REJECTED   // Declined by admin
  SUSPENDED  // Temporarily locked by admin
}

enum AuditAction {
  // Organiser lifecycle
  ORGANISER_APPROVED
  ORGANISER_REJECTED
  ORGANISER_SUSPENDED
  ORGANISER_REINSTATED

  // User management
  USER_SUSPENDED
  USER_DELETED
  USER_STATUS_CHANGED

  // Auth events
  MAGIC_LINK_SENT
  LOGIN_SUCCESS
  LOGIN_FAILED
  SESSION_REVOKED

  // Points (Phase 4)
  POINTS_AWARDED
  POINTS_DEDUCTED

  // Tournaments & Events
  TOURNAMENT_CREATED
  TOURNAMENT_SUBMITTED
  TOURNAMENT_APPROVED
  TOURNAMENT_REJECTED
  TOURNAMENT_CANCELLED
  TOURNAMENT_UPDATED
  TOURNAMENT_DELETED
  EVENT_CREATED
  EVENT_SUBMITTED
  EVENT_APPROVED
  EVENT_REJECTED
  EVENT_CANCELLED
  EVENT_UPDATED
  EVENT_DELETED

  // Games
  GAME_CREATED
  GAME_UPDATED
  GAME_DELETED

  // Teams
  TEAM_UPDATED
  TEAM_DELETED

  // Connections
  CONNECTION_REMOVED

  // User management
  USER_ROLE_CHANGED
}

enum TournamentFormat {
  BEST_OF_ONE
  BEST_OF_THREE
  OTHER
}

enum TournamentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventType {
  PHYSICAL
  DIGITAL
  HYBRID
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TeamMemberRole {
  CAPTAIN
  MEMBER
}

enum TeamStatus {
  ACTIVE
  DISBANDED
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// ─────────────────────────────────────────
// USERS
// Core identity record for all roles.
// SingPass fields (nric_hash, legal_name) are
// nullable now — populated when SingPass is integrated.
// ─────────────────────────────────────────

model User {
  id          String        @id @default(uuid()) @db.Uuid
  email       String        @unique
  role        Role          @default(GAMER)
  status      AccountStatus @default(PENDING)

  // SingPass fields — null until integration
  nric_hash   String?       @unique  // bcrypt/SHA-256 one-way hash, never plaintext
  legal_name  String?                // from Myinfo, not publicly displayed by default

  // Contact
  phone       String?                // SG local number (8 digits), always prefixed +65 on display

  created_at  DateTime      @default(now()) @db.Timestamptz
  updated_at  DateTime      @updatedAt @db.Timestamptz

  // Relations
  organiser_profile       OrganiserProfile?
  gamer_profile           GamerProfile?
  auth_tokens             AuthToken[]
  refresh_tokens          RefreshToken[]
  audit_logs_actor        AuditLog[]        @relation("AuditActor")
  audit_logs_target       AuditLog[]        @relation("AuditTarget")
  organised_tournaments   Tournament[]      @relation("TournamentOrganiser")
  tournament_registrations TournamentRegistration[]
  organised_events        Event[]           @relation("EventOrganiser")
  event_registrations     EventRegistration[]
  sent_connections         Connection[]      @relation("ConnectionRequester")
  received_connections     Connection[]      @relation("ConnectionAddressee")
  team_memberships         TeamMember[]
  team_invites_received    TeamInvite[]      @relation("TeamInviteInvitee")
  team_invites_sent        TeamInvite[]      @relation("TeamInviteInviter")
  created_teams            Team[]            @relation("TeamCreator")

  @@index([email])
  @@index([role, status])
  @@map("users")
}

// ─────────────────────────────────────────
// ORGANISER PROFILE
// Extended data for Organiser accounts.
// Created at signup, visible to Admin during review.
// ─────────────────────────────────────────

model OrganiserProfile {
  id               String   @id @default(uuid()) @db.Uuid
  user_id          String   @unique @db.Uuid
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  organisation_name  String
  organisation_type  String         // e.g. "Company", "School", "Association", "Individual"
  website            String?
  contact_person     String         // Name of the person registering
  contact_number     String?
  description        String?        @db.Text

  // Admin review fields
  reviewed_by        String?        @db.Uuid   // Admin user ID who made the decision
  reviewed_at        DateTime?      @db.Timestamptz
  rejection_reason   String?        @db.Text

  created_at         DateTime       @default(now()) @db.Timestamptz
  updated_at         DateTime       @updatedAt @db.Timestamptz

  @@map("organiser_profiles")
}

// ─────────────────────────────────────────
// GAMER PROFILE
// Stub for Phase 1 — expanded in Phase 4.
// ─────────────────────────────────────────

model GamerProfile {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @unique @db.Uuid
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  username        String   @unique
  display_name    String?
  bio             String?  @db.VarChar(300)
  avatar_url      String?
  banner_url      String?

  // Username change throttle — cannot change more than once per 90 days
  username_changed_at  DateTime?  @db.Timestamptz

  // Visibility: PUBLIC | MEMBERS_ONLY | PRIVATE
  visibility      String   @default("PUBLIC")

  // Membership
  is_member       Boolean  @default(false)
  member_since    DateTime? @db.Timestamptz
  member_until    DateTime? @db.Timestamptz

  // Points (Phase 4 — stored here for fast dashboard reads)
  points_balance  Int      @default(0)

  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  games GamerProfileGame[]

  @@index([username])
  @@map("gamer_profiles")
}

// ─────────────────────────────────────────
// GAMES LIBRARY
// Platform-managed game library used across
// profiles, teams, tournaments, and jobs.
// Only admins can create/edit/disable games.
// ─────────────────────────────────────────

model Game {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  cover_image String?
  category    String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  gamer_profiles GamerProfileGame[]
  tournaments    Tournament[]
  team_games     TeamGame[]

  @@index([slug])
  @@index([category])
  @@map("games")
}

model GamerProfileGame {
  profile_id   String  @db.Uuid
  game_id      String  @db.Uuid
  in_game_role String?
  profile      GamerProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  game         Game         @relation(fields: [game_id], references: [id], onDelete: Cascade)

  @@id([profile_id, game_id])
  @@map("gamer_profile_games")
}

// ─────────────────────────────────────────
// TOURNAMENTS
// Competitive tournament listings created by organisers.
// ─────────────────────────────────────────

model Tournament {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String
  description         String           @db.Text
  game_id             String           @db.Uuid
  game                Game             @relation(fields: [game_id], references: [id])
  format              TournamentFormat @default(OTHER)
  platform            String?
  registration_start  DateTime         @db.Timestamptz
  registration_end    DateTime         @db.Timestamptz
  tournament_start    DateTime         @db.Timestamptz
  tournament_end      DateTime         @db.Timestamptz
  is_online           Boolean          @default(false)
  venue               String?
  is_team_based       Boolean          @default(false)
  max_participants    Int?
  prize_pool          String?
  registration_fee    Float?           @db.DoublePrecision
  ruleset_url         String?
  organiser_id        String           @db.Uuid
  organiser           User             @relation("TournamentOrganiser", fields: [organiser_id], references: [id])
  status              TournamentStatus @default(DRAFT)

  // Admin review
  reviewed_by     String?   @db.Uuid
  reviewed_at     DateTime? @db.Timestamptz
  rejection_reason String?  @db.Text

  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  registrations TournamentRegistration[]

  @@index([status])
  @@index([organiser_id])
  @@index([game_id])
  @@index([tournament_start])
  @@map("tournaments")
}

model TournamentRegistration {
  id            String             @id @default(uuid()) @db.Uuid
  tournament_id String             @db.Uuid
  tournament    Tournament         @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  user_id       String             @db.Uuid
  user          User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  team_id       String?            @db.Uuid
  team          Team?              @relation(fields: [team_id], references: [id], onDelete: SetNull)
  status        RegistrationStatus @default(PENDING)
  registered_at DateTime           @default(now()) @db.Timestamptz
  checked_in_at DateTime?          @db.Timestamptz

  @@unique([tournament_id, user_id])
  @@index([user_id])
  @@index([status])
  @@map("tournament_registrations")
}

// ─────────────────────────────────────────
// EVENTS
// Community event listings created by organisers.
// ─────────────────────────────────────────

model Event {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String
  description         String           @db.Text
  event_type          EventType        @default(DIGITAL)
  access_type         String           @default("PUBLIC")
  capacity            Int?
  registration_start  DateTime         @db.Timestamptz
  registration_end    DateTime         @db.Timestamptz
  event_start         DateTime         @db.Timestamptz
  event_end           DateTime         @db.Timestamptz
  venue               String?
  is_online           Boolean          @default(false)
  age_restrictions    String?
  registration_fee    Float?           @db.DoublePrecision
  points_awarded      Int              @default(0)
  organiser_id        String           @db.Uuid
  organiser           User             @relation("EventOrganiser", fields: [organiser_id], references: [id])
  status              TournamentStatus @default(DRAFT)

  // Admin review
  reviewed_by     String?   @db.Uuid
  reviewed_at     DateTime? @db.Timestamptz
  rejection_reason String?  @db.Text

  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  registrations EventRegistration[]

  @@index([status])
  @@index([organiser_id])
  @@index([event_type])
  @@index([event_start])
  @@map("events")
}

model EventRegistration {
  id            String             @id @default(uuid()) @db.Uuid
  event_id      String             @db.Uuid
  event         Event              @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user_id       String             @db.Uuid
  user          User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status        RegistrationStatus @default(PENDING)
  registered_at DateTime           @default(now()) @db.Timestamptz
  checked_in_at DateTime?          @db.Timestamptz

  @@unique([event_id, user_id])
  @@index([user_id])
  @@index([status])
  @@map("event_registrations")
}

// ─────────────────────────────────────────
// CONNECTIONS
// Bidirectional (LinkedIn-style) social connections.
// requester sends → addressee accepts/rejects.
// Once ACCEPTED, both are mutually connected.
// ─────────────────────────────────────────

model Connection {
  id            String           @id @default(uuid()) @db.Uuid
  requester_id  String           @db.Uuid
  requester     User             @relation("ConnectionRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee_id  String           @db.Uuid
  addressee     User             @relation("ConnectionAddressee", fields: [addressee_id], references: [id], onDelete: Cascade)
  status        ConnectionStatus @default(PENDING)
  created_at    DateTime         @default(now()) @db.Timestamptz
  updated_at    DateTime         @updatedAt @db.Timestamptz

  @@unique([requester_id, addressee_id])
  @@index([addressee_id, status])
  @@index([requester_id, status])
  @@map("connections")
}

// ─────────────────────────────────────────
// TEAMS
// Team profiles with roster management.
// Created by GAMER users; the creator becomes CAPTAIN.
// Teams can register for tournaments (team-based).
// ─────────────────────────────────────────

model Team {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  tag          String     @unique // short, max 6 chars, e.g. "T1", "PRX"
  description  String?    @db.Text
  logo_url     String?
  banner_url   String?
  is_recruiting Boolean  @default(true)
  status       TeamStatus @default(ACTIVE)
  created_by   String     @db.Uuid
  creator      User       @relation("TeamCreator", fields: [created_by], references: [id])

  created_at   DateTime   @default(now()) @db.Timestamptz
  updated_at   DateTime   @updatedAt @db.Timestamptz

  members                   TeamMember[]
  games                     TeamGame[]
  invites                   TeamInvite[]
  tournament_registrations  TournamentRegistration[]

  @@index([tag])
  @@index([status])
  @@index([created_by])
  @@map("teams")
}

model TeamMember {
  team_id  String          @db.Uuid
  team     Team            @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user_id  String          @db.Uuid
  user     User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role     TeamMemberRole  @default(MEMBER)
  joined_at DateTime       @default(now()) @db.Timestamptz
  left_at   DateTime?      @db.Timestamptz // null = still active

  @@id([team_id, user_id])
  @@index([user_id])
  @@map("team_members")
}

model TeamInvite {
  id         String           @id @default(uuid()) @db.Uuid
  team_id    String           @db.Uuid
  team       Team             @relation(fields: [team_id], references: [id], onDelete: Cascade)
  inviter_id String           @db.Uuid
  inviter    User             @relation("TeamInviteInviter", fields: [inviter_id], references: [id])
  invitee_id String           @db.Uuid
  invitee    User             @relation("TeamInviteInvitee", fields: [invitee_id], references: [id], onDelete: Cascade)
  status     TeamInviteStatus @default(PENDING)
  created_at DateTime         @default(now()) @db.Timestamptz
  updated_at DateTime         @updatedAt @db.Timestamptz

  @@unique([team_id, invitee_id])
  @@index([invitee_id, status])
  @@index([team_id, status])
  @@map("team_invites")
}

model TeamGame {
  team_id String @db.Uuid
  team    Team   @relation(fields: [team_id], references: [id], onDelete: Cascade)
  game_id String @db.Uuid
  game    Game   @relation(fields: [game_id], references: [id], onDelete: Cascade)

  @@id([team_id, game_id])
  @@map("team_games")
}

// ─────────────────────────────────────────
// AUTH TOKENS
// Magic-link / OTP tokens issued via Resend.
// One-time use, short expiry (30 mins default).
// SingPass will bypass this table entirely —
// it handles its own token exchange via OAuth.
// ─────────────────────────────────────────

model AuthToken {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  token_hash  String    @unique   // SHA-256 hash of the raw token sent in the email
  expires_at  DateTime  @db.Timestamptz
  used_at     DateTime? @db.Timestamptz  // null = unused, set on first use
  created_at  DateTime  @default(now()) @db.Timestamptz

  // IP + user agent for audit trail
  request_ip  String?
  user_agent  String?

  @@index([token_hash])
  @@index([user_id])
  @@map("auth_tokens")
}

// ─────────────────────────────────────────
// REFRESH TOKENS
// Long-lived tokens for session renewal.
// Stored in DB so they can be individually revoked
// (e.g. on account suspension).
// ─────────────────────────────────────────

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  token_hash   String    @unique
  expires_at   DateTime  @db.Timestamptz
  revoked_at   DateTime? @db.Timestamptz   // null = active
  created_at   DateTime  @default(now()) @db.Timestamptz

  // Device fingerprint — useful for "sign out of all devices"
  request_ip   String?
  user_agent   String?

  @@index([token_hash])
  @@index([user_id])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// AUDIT LOGS
// Immutable record of all admin actions.
// Insert-only — never update or delete rows.
// ─────────────────────────────────────────

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid

  actor_id     String      @db.Uuid          // Admin who performed the action
  actor        User        @relation("AuditActor", fields: [actor_id], references: [id])

  target_id    String?     @db.Uuid          // User/entity acted upon (nullable for system events)
  target       User?       @relation("AuditTarget", fields: [target_id], references: [id])

  action       AuditAction
  target_type  String?                       // e.g. "organiser", "listing", "user"
  metadata     Json?                         // Extra context — rejection reason, old/new values, etc.
  ip_address   String?

  created_at   DateTime    @default(now()) @db.Timestamptz

  @@index([actor_id])
  @@index([target_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// RATE LIMIT BUCKETS
// Simple DB-backed rate limiting for auth endpoints.
// Replace with Redis in production at scale.
// ─────────────────────────────────────────

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique   // e.g. "magic_link:user@email.com" or "login:1.2.3.4"
  count       Int      @default(1)
  window_start DateTime @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  @@index([key])
  @@map("rate_limit_buckets")
}
